#!/bin/sh
# tspace: Herdr-style spaces on tmux. See docs/tmux-bar.md in the dotfiles repo.
# Absolute paths throughout, because SwiftBar runs this with a bare PATH.
# TSPACE_SOCKET=<name> targets a tmux server started with -L <name> (for tests).
set -eu
TMUX_BIN=/opt/homebrew/bin/tmux
JQ=/opt/homebrew/bin/jq
FISH=/opt/homebrew/bin/fish

t() {
  if [ -n "${TSPACE_SOCKET:-}" ]; then "$TMUX_BIN" -L "$TSPACE_SOCKET" "$@"; else "$TMUX_BIN" "$@"; fi
}

usage() {
  cat >&2 <<'EOF'
usage: tspace ls [--json]
       tspace space new --name N [--folder F] [--argv '["cmd", ...]'] [--task T]
       tspace tab new [--space S] [--name N] [--folder F] [--argv '[...]'] [--task T] [--focus false]
       tspace focus <terminal> [--one-window-per-space]
EOF
  exit 2
}

# Like herdr-app do: errors are {"error": "..."} on stdout, exit 1.
fail() {
  "$JQ" -nc --arg e "$*" '{error: $e}'
  exit 1
}

need() { [ "$1" -ge 2 ] || fail "$2 needs a value"; }

# What space new and tab new print, as herdr-app do does.
MADE='{"space":"#{session_id}","tab":"#{window_id}","terminal":"#{pane_id}"}'

# One line per pane, fields separated by the ASCII unit separator so empty
# fields survive. Plain shells have no @agent; fall back to the running command,
# as hc does. Sessions made outside tspace have no @space_name; use the name.
SEP=$(printf '\037')
FORMAT="#{pane_id}${SEP}#{?@agent,#{@agent},#{pane_current_command}}${SEP}#{pane_current_path}${SEP}#{@agent_status}${SEP}#{?@space_name,#{@space_name},#{session_name}} / #{window_index}${SEP}#{session_id}${SEP}#{window_id}"

ls_json() {
  # Exits non-zero with no output when no tmux server runs, as hc ls does.
  panes=$(t list-panes -a -F "$FORMAT" 2>/dev/null) || { echo "tspace: no tmux server running" >&2; exit 1; }
  printf '%s\n' "$panes" | "$JQ" -R -s -c --arg sep "$SEP" '
    {terminals: [split("\n")[] | select(length > 0) | split($sep)
      | {address: .[0], agent: .[1], cwd: .[2], status: .[3], where: .[4], space: .[5], tab: .[6]}
      | if .status == "" then del(.status) else . end]}'
}

# argv (a JSON array of strings) plus an optional task as its last argument,
# quoted as one fish command line. In fish single quotes only \ and ' are special.
FISH_LINE=$(cat <<'JQ'
if type != "array" or length == 0 or any(.[]; type != "string")
then error("--argv must be a non-empty JSON array of strings") else . end
| if $task != "" then . + [$task] else . end
| map("'" + (gsub("\\\\"; "\\\\") | gsub("'"; "\\'")) + "'")
| join(" ")
JQ
)

# Sets $cmd and $tab_name. Agents run as `fish -lic <argv>` with no `exec fish`
# after, so the login PATH applies and quitting the agent closes its pane.
# The tab is named after the agent (argv[0]), since tmux would show "fish".
build_command() {
  cmd= tab_name=
  if [ -z "$argv" ]; then
    [ -z "$task" ] || fail "--task needs --argv"
    return 0
  fi
  cmd=$(printf '%s' "$argv" | "$JQ" -r --arg task "$task" "$FISH_LINE" 2>/dev/null) \
    || fail "--argv must be a non-empty JSON array of strings"
  tab_name=$(printf '%s' "$argv" | "$JQ" -r '.[0] | split("/") | last')
}

# Sets $folder to the absolute form of $1.
absolute_folder() {
  [ -d "$1" ] || fail "no such folder: $1"
  folder=$(cd "$1" && pwd)
}

# tmux session names can't hold . or :, so the name is a slug of the display
# name, made unique with -2, -3, ... The display name goes in @space_name.
slug_for() {
  base=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  [ -n "$base" ] || base=space
  slug=$base n=1
  while t has-session -t "=$slug" 2>/dev/null; do
    n=$((n + 1)); slug="$base-$n"
  done
  printf '%s' "$slug"
}

space_new() {
  name= folder=$PWD argv= task=
  while [ $# -gt 0 ]; do
    case $1 in
      --name) need $# "$1"; name=$2; shift 2 ;;
      --folder) need $# "$1"; folder=$2; shift 2 ;;
      --argv) need $# "$1"; argv=$2; shift 2 ;;
      --task) need $# "$1"; task=$2; shift 2 ;;
      *) fail "unknown argument: $1" ;;
    esac
  done
  [ -n "$name" ] || fail "space new needs --name"
  absolute_folder "$folder"
  build_command
  slug=$(slug_for "$name")

  set -- new-session -d -s "$slug" -c "$folder" -P -F "$MADE"
  [ -z "$cmd" ] || set -- "$@" -n "$tab_name" "$FISH" -lic "$cmd"
  made=$(t "$@" 2>&1) || fail "tmux: $made"
  space=$(printf '%s' "$made" | "$JQ" -r .space)
  t set -t "$space" @space_name "$name"
  t set -t "$space" @space_folder "$folder"
  printf '%s\n' "$made"
}

# A session id ($3), session name, or display name; empty means this pane's space.
resolve_space() {
  if [ -z "$1" ]; then
    [ -n "${TMUX_PANE:-}" ] || return 1
    t display -p -t "$TMUX_PANE" '#{session_id}' 2>/dev/null
    return
  fi
  t list-sessions -F "#{session_id}${SEP}#{session_name}${SEP}#{@space_name}" 2>/dev/null \
    | "$JQ" -R -r --arg s "$1" --arg sep "$SEP" 'split($sep) | select(.[0] == $s or .[1] == $s or .[2] == $s) | .[0]' \
    | head -n 1
}

tab_new() {
  space= name= folder= argv= task= focus=true
  while [ $# -gt 0 ]; do
    case $1 in
      --space) need $# "$1"; space=$2; shift 2 ;;
      --name) need $# "$1"; name=$2; shift 2 ;;
      --folder) need $# "$1"; folder=$2; shift 2 ;;
      --argv) need $# "$1"; argv=$2; shift 2 ;;
      --task) need $# "$1"; task=$2; shift 2 ;;
      --focus) need $# "$1"; focus=$2; shift 2 ;;
      *) fail "unknown argument: $1" ;;
    esac
  done
  case $focus in true | false) ;; *) fail "--focus must be true or false" ;; esac
  sid=$(resolve_space "$space") || true
  if [ -z "$sid" ]; then
    [ -n "$space" ] && fail "no space: $space"
    fail "tab new needs --space outside tmux"
  fi
  if [ -n "$folder" ]; then
    absolute_folder "$folder"
  else
    folder=$(t display -p -t "$sid" '#{?@space_folder,#{@space_folder},#{session_path}}')
  fi
  build_command

  set -- new-window -t "$sid:" -c "$folder" -P -F "$MADE"
  [ "$focus" = true ] || set -- "$@" -d
  [ -n "$name" ] || name=$tab_name
  [ -z "$name" ] || set -- "$@" -n "$name"
  [ -z "$cmd" ] || set -- "$@" "$FISH" -lic "$cmd"
  made=$(t "$@" 2>&1) || fail "tmux: $made"
  printf '%s\n' "$made"
}

GHOSTTY_SCRIPT="$HOME/.config/tspace/ghostty.applescript"
ghostty() { /usr/bin/osascript "$GHOSTTY_SCRIPT" "$@"; }

# tmux clients running in a Ghostty terminal, most recently active first, as
# "<tty> <session_id>" lines. Clients in other terminal apps are left out, so
# focus never switches a client that Ghostty can't bring to the front.
ghostty_clients() {
  /usr/bin/pgrep -xq ghostty || return 0
  ttys=$(ghostty ttys 2>/dev/null) || return 0
  t list-clients -F '#{client_activity} #{client_tty} #{session_id}' 2>/dev/null | sort -rn |
    while read -r _ tty sess; do
      if printf '%s\n' "$ttys" | grep -qxF "$tty"; then printf '%s %s\n' "$tty" "$sess"; fi
    done
}

# Show a pane in Ghostty: reuse a Ghostty tmux client (one already on the
# pane's space first, else any, unless one window per space is asked for),
# or open a Ghostty window attached to it.
focus() {
  [ $# -ge 1 ] || usage
  pane=$1; shift
  per_space=${TSPACE_ONE_WINDOW_PER_SPACE:-0}
  for a in "$@"; do
    case $a in
      --one-window-per-space) per_space=1 ;;
      *) fail "unknown argument: $a" ;;
    esac
  done
  # tmux can succeed with empty fields for an unknown pane, so check the result.
  target=$(t display -p -t "$pane" '#{pane_id} #{session_id} #{window_id}' 2>/dev/null) || target=
  case $target in %*) ;; *) fail "no such terminal: $pane" ;; esac
  set -- $target
  pane=$1 sid=$2 wid=$3

  clients=$(ghostty_clients)
  client=$(printf '%s\n' "$clients" | awk -v s="$sid" '$2 == s { print $1; exit }')
  if [ -z "$client" ] && [ "$per_space" != 1 ]; then
    client=$(printf '%s\n' "$clients" | awk 'NF { print $1; exit }')
  fi

  if [ -n "$client" ]; then
    t switch-client -c "$client" -t "$pane"
  else
    attach=$TMUX_BIN
    [ -z "${TSPACE_SOCKET:-}" ] || attach="$attach -L $TSPACE_SOCKET"
    ghostty new "$attach attach -t $pane" >/dev/null 2>&1 || fail "could not open a Ghostty window"
    i=0
    while [ -z "$client" ] && [ $i -lt 50 ]; do
      sleep 0.1; i=$((i + 1))
      client=$(ghostty_clients | awk -v s="$sid" '$2 == s { print $1; exit }')
    done
    [ -n "$client" ] || fail "Ghostty window opened but did not attach to tmux"
  fi
  t select-window -t "$wid"
  t select-pane -t "$pane"
  [ "$(ghostty focus "$client" 2>/dev/null)" = ok ] || fail "Ghostty terminal $client not found"
  "$JQ" -nc --arg terminal "$pane" --arg client "$client" '{terminal: $terminal, client: $client}'
}

case "${1:-} ${2:-}" in
  "ls ") ls_json | "$JQ" -r '.terminals[] | [.address, .where, .agent, (.status // "-"), .cwd] | @tsv' ;;
  "ls --json") ls_json ;;
  "space new") shift 2; space_new "$@" ;;
  "tab new") shift 2; tab_new "$@" ;;
  focus\ *) shift; focus "$@" ;;
  *) usage ;;
esac
